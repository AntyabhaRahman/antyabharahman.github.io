---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
interface Props { title: string; description?: string; }
const { title, description = 'Projects, blog posts, and research by Antyabha Rahman.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
	['/projects/', 'Projects'],
	['/blog/', 'Blog'],
	['/research/', 'Research'],
];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<slot name="head" />
		<link rel="preload" href="/fonts/Archivo-800-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/IBMPlexMono-400-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/IBMPlexMono-500-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/IBMPlexSans-400-latin.woff2" as="font" type="font/woff2" crossorigin />
		{/* Runs before paint so the page never flashes the wrong theme. Kept on one line: inline scripts ship as written. */}
		<script is:inline>(function(){var s=localStorage.getItem('theme');document.documentElement.dataset.theme=(s?s==='dark':matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light'})()</script>
	</head>
	<body>
		<svg width="0" height="0" aria-hidden="true" style="position:absolute">
			<filter id="sketch" x="-4%" y="-4%" width="108%" height="108%">
				<feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="2" seed="7" result="n" />
				<feDisplacementMap in="SourceGraphic" in2="n" scale="3" xChannelSelector="R" yChannelSelector="G" />
			</filter>
			<filter id="sketch-faint" x="-4%" y="-4%" width="108%" height="108%">
				<feTurbulence type="fractalNoise" baseFrequency="0.016" numOctaves="2" seed="19" result="n" />
				<feDisplacementMap in="SourceGraphic" in2="n" scale="2.4" xChannelSelector="R" yChannelSelector="G" />
			</filter>
		</svg>
		<header class="site-header wrap">
			<div class="ident"><a class="wordmark" href="/" data-px>Antyabha Rahman</a><span class="role" data-px>Engineer and researcher</span></div>
			<nav class="nav" aria-label="Site">
				{nav.map(([href, label]) => (
					<a class="u" href={href} aria-current={path.startsWith(href) ? 'page' : undefined} data-px>{label}</a>
				))}
				<ThemeToggle />
			</nav>
		</header>
		<slot />
		<script>
			import '../scripts/pixel-type.js';
		</script>
		<footer class="site-footer wrap" data-px>
			<span>© {new Date().getFullYear()} Antyabha Rahman</span>
			<a class="u" href="https://github.com/AntyabhaRahman">github.com/AntyabhaRahman</a>
		</footer>
	</body>
</html>
