---
import '../styles/global.css';
import { createHash } from 'node:crypto';
import themeInit from '../scripts/theme-init.js?raw';
import ThemeToggle from '../components/ThemeToggle.astro';
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(themeInit).digest('base64')}`);
interface Props { title: string; description?: string; }
const { title, description = 'Projects, blog posts, and research by Antyabha Rahman.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
	['/projects/', 'Projects'],
	['/blog/', 'Blog'],
	['/research/', 'Research'],
];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<slot name="head" />
		<link rel="preload" href="/fonts/Archivo-800-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/IBMPlexMono-400-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/IBMPlexMono-500-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/IBMPlexSans-400-latin.woff2" as="font" type="font/woff2" crossorigin />
		{/* Runs before paint: sets the theme so the page never flashes the wrong one, and hides the text
		    under px-wait so the entrance draws first. The module removes px-wait; a 3 s timer is the
		    safety net if it fails. The inline source is hashed for CSP at build time. */}
		{/* The same two rules as in global.css. Inline, they hold before the stylesheet arrives,
		    so WebKit never paints the marks for one frame. */}
		<style is:inline>.px-wait [data-px],.px-wait [data-px-border]{visibility:hidden}.px-wait .nav a[aria-current='page']::before,.px-wait .panel-draw,.px-wait .about-draw,.px-wait .theme-toggle svg,.px-wait .note svg{opacity:0}</style>
	</head>
	<body>
		<script is:inline set:html={themeInit} />
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header wrap">
			<div class="ident"><a class="wordmark" href="/" data-px>Antyabha Rahman</a><span class="role" data-px>Engineer and researcher</span></div>
			<nav class="nav" aria-label="Site">
				{nav.map(([href, label]) => (
					<a class="u" href={href} aria-current={path.startsWith(href) ? 'page' : undefined} data-px>{label}</a>
				))}
				<ThemeToggle />
			</nav>
		</header>
		<slot />
		<script>
			import '../scripts/pixel-type.js';
		</script>
		<footer class="site-footer wrap" data-px>
			<span>© {new Date().getFullYear()} Antyabha Rahman</span>
			<a class="u" href="https://github.com/AntyabhaRahman">github.com/AntyabhaRahman</a>
		</footer>
	</body>
</html>
