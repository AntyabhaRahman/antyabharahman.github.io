---
// Shared page for one blog post, one paper, or one project. The trail canvas sits behind the text.
import 'katex/dist/katex.min.css';
import Base from './Base.astro';
import PixelCanvas from '../components/PixelCanvas.astro';
import Note from '../components/Note.astro';
interface Props { title: string; description: string; kicker: string; backHref: string; backLabel: string; }
const { title, description, kicker, backHref, backLabel } = Astro.props;
---
<Base title={`${title} · Antyabha Rahman`} description={description}>
	<div class="pf-fixed"><PixelCanvas mode="trail" /></div>
	<main class="article wrap" data-px>
		<header>
			<div class="article-rail">
				<Note dir="left"><a class="u" href={backHref}>{backLabel}</a></Note>
				<p class="hand">{kicker}</p>
				<slot name="meta" />
				<div class="article-notes"><slot name="notes" /></div>
			</div>
			<h1 class="display">{title}</h1>
		</header>
		<div class="prose">
			<slot />
		</div>
	</main>
</Base>
