---
// Sun and moon drawn as loose ink strokes. The swap uses the View Transition API when the browser has it.
---
<button class="theme-toggle" type="button" aria-label="Switch to dark mode">
	<svg viewBox="0 0 24 24" aria-hidden="true">
		<g class="sun">
			<path d="M12 7.4 C18.1 7.1 18.4 16.5 12.2 16.7 C6 17 5.9 7.8 12 7.4Z" />
			<path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M5.3 18.7 7 17M17 7l1.7-1.7" />
		</g>
		<path class="moon" d="M14.6 3.2 C5.8 1.8 1 12.4 6.8 18.4 C10.8 22.6 18 21.5 20.8 15.9 C12.5 18.1 9.2 8.6 14.6 3.2Z" />
	</svg>
</button>

<style>
	.theme-toggle {
		width: 2.2rem; height: 2.2rem; padding: 0; border: 0; background: none; color: var(--ink); cursor: pointer;
		flex: 0 0 auto; display: grid; place-items: center; border-radius: 50%;
	}
	@media (hover: none) { .theme-toggle { width: 2.75rem; height: 2.75rem; } }
	.theme-toggle svg { width: 1.35rem; height: 1.35rem; fill: none; stroke: currentColor; stroke-width: 1.78; stroke-linecap: round; stroke-linejoin: round; }
	.sun { transform-origin: 12px 12px; transition: transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 200ms; }
	.moon { transition: opacity 200ms; }
	:global([data-theme='dark']) .sun { opacity: 0; transform: rotate(90deg) scale(0.6); }
	:global([data-theme='light']) .moon { opacity: 0; }
</style>

<script>
	const btn = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
	const root = document.documentElement;

	function sync() {
		const dark = root.dataset.theme === 'dark';
		btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
	}

	// A null origin skips the canvas wave; reduced motion uses a 120ms CSS dissolve.
	function apply(origin: { x: number; y: number } | null = null) {
		root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
		// Persistence is optional; blocked storage must not interrupt the visible theme update.
		try { localStorage.setItem('theme', root.dataset.theme); } catch {}
		sync();
		document.dispatchEvent(new CustomEvent('themechange', { detail: origin }));
	}

	btn.addEventListener('click', () => {
		const r = btn.getBoundingClientRect();
		const origin = { x: r.left + r.width / 2, y: r.top + r.height / 2 };
		// As percentages of the viewport. Chromium renders px in the wipe's clip-path at half
		// scale, which put the circle at the top centre. Percentages land on the button.
		root.style.setProperty('--vt-x', `${(origin.x / innerWidth) * 100}%`);
		root.style.setProperty('--vt-y', `${(origin.y / innerHeight) * 100}%`);
		if ('startViewTransition' in document) {
			const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
			(document as any).startViewTransition(() => apply(reduced ? null : origin));
		} else {
			apply();
		}
	});
	sync();
</script>
