---
// Three tall paper panels. A hover or focus widens one panel and reveals its newest items. skiper35 style.
interface Item { href: string; title: string; date: Date; }
interface Panel { href: string; title: string; blurb: string; items: Item[]; count: number; }
// Ink drawings, one per sheet: a box with a face, a page with a pencil, a flask. Each has a hatch layer for shading.
const drawings = [
	{ line: 'M8 10 h32 v30 h-32 z M14 22 l3 3 M31 22 l3 3 M17 33 c6 4 10 4 16 0 M4 44 h40',
	  hatch: 'M9 40 l4 -4 M9 36 l7 -7 M9 32 l5 -5 M36 40 l4 -4 M33 40 l7 -7' },
	{ line: 'M10 6 h22 l8 8 v30 h-30 z M32 6 v8 h8 M16 23 h17 M16 29 h9 M16 36 h7 M29 30 l12 11 -3 3 -12 -11 z M29 30 l-3 3',
	  hatch: 'M11 42 l5 -5 M11 38 l4 -4 M33 8 l6 6 M35 7 l4 4' },
	{ line: 'M20 4 h10 M22 4 v12 l-12 24 c-2 4 1 6 4 6 h22 c3 0 6 -2 4 -6 l-12 -24 v-12 M14 34 c6 -4 8 2 12 -2 c3 -3 6 4 10 0',
	  hatch: 'M14 39 l4 -4 M17 42 l6 -7 M22 43 l7 -8 M28 43 l6 -7 M33 43 l3 -4 M16 37 l7 6 M22 36 l8 7 M29 36 l7 6' },
];
interface Props { panels: Panel[]; }
const { panels } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---
<div class="deck">
	{panels.map((p, i) => (
		<article class="panel rough" data-px-border style={`--tilt:${[-0.7, 0.45, -0.35][i]}deg`}>
			<div class="panel-side">
				<svg class="panel-draw" viewBox="0 0 48 48" aria-hidden="true">
					<path class="hatch" d={drawings[i].hatch} />
					<path d={drawings[i].line} />
				</svg>
				<dl class="panel-spec hand" data-px>
					<div><dt>Entries</dt><dd>{String(p.count).padStart(2, '0')}</dd></div>
					<div><dt class="sr">Updated</dt><dd>{p.items[0] ? fmt(p.items[0].date) : 'Not published yet'}</dd></div>
				</dl>
				<h2 class="panel-title display" data-px><a href={p.href}>{p.title}</a></h2>
			</div>
			<div class="panel-body" data-px>
				<div class="panel-stack">
				<p class="panel-blurb">{p.blurb}</p>
				{p.title === 'Blog' && !p.items.length && <p class="panel-empty">No posts yet</p>}
				<ol class="panel-items">
					{p.items.map((it) => (
						<li>
							<a class="u" href={it.href}>{it.title}</a>
							<span class="hand">{fmt(it.date)}</span>
						</li>
					))}
				</ol>
				</div>
				<a class="panel-all u" href={p.href}>{p.title === 'Blog' ? 'View blog' : `All ${p.title.toLowerCase()}`}</a>
			</div>
		</article>
	))}
</div>

<script>
	// The deck is a size container, so a sheet can be capped at the deck height. Chromium
	// resolves cqh to 0 for a flex-grown container, so the height is copied into a variable.
	// The first write is synchronous: the observer's first call can land after the entrance
	// has sampled the sheets, and a sheet without a height collapses.
	const deck = document.querySelector('.deck');
	if (deck) {
		const set = (h) => deck.style.setProperty('--deck-h', `${h}px`);
		set(deck.getBoundingClientRect().height);
		new ResizeObserver(([e]) => set(e.contentRect.height)).observe(deck);
	}
</script>
<style>
	.deck {
		display: flex; gap: 1.25rem; align-items: flex-start;
		flex: 1 1 auto; min-height: 22rem;
		position: relative; z-index: 1;
		container-type: size;
	}
	/* Equal-height sheets fit within the hero; entry counts stay in the printed spec. */
	.panel {
		height: min(var(--deck-h, 100cqh), 38rem);
		flex: 1 1 0; min-width: 5.5rem;
		background: color-mix(in srgb, var(--paper) 78%, transparent); box-shadow: var(--shadow);
		display: grid; grid-template-columns: auto 1fr; grid-template-rows: minmax(0, 1fr); overflow: hidden;
		transform: rotate(var(--tilt));
		transition: flex 496ms cubic-bezier(0.32, 0.72, 0, 1), transform 496ms cubic-bezier(0.32, 0.72, 0, 1), background-color 320ms ease;
	}
	.deck:has(.panel:hover) .panel, .deck:has(.panel:focus-within) .panel { transform: rotate(0deg); }
	:where(.deck:not(:has(.panel:focus-within))) .panel:hover, .panel:focus-within { flex-grow: 3.2; transform: rotate(0deg) translateY(-4px); background: color-mix(in srgb, var(--paper) 96%, transparent); }
	.panel-side { display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; padding: 1rem 1.2rem; }
	.panel-draw { width: 2.5rem; height: 2.5rem; flex-shrink: 0; fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: transform 400ms cubic-bezier(0.32, 0.72, 0, 1), opacity 256ms ease; }
	.panel-draw .hatch { stroke: var(--graphite); stroke-width: 0.7; opacity: 0.7; }
	:where(.deck:not(:has(.panel:focus-within))) .panel:hover .panel-draw, .panel:focus-within .panel-draw { transform: rotate(-3deg); }
	.panel-title {
		margin: auto 0 0; font-size: clamp(1.8rem, calc(var(--deck-h, 352px) * 0.08), 2.4rem); flex-shrink: 0;
		writing-mode: vertical-rl; transform: rotate(180deg); line-height: 1;
	}
	.panel-title a { display: block; }
	.panel-body {
		padding: 2rem 2rem 2rem 0.75rem; min-width: 18rem; min-height: 0;
		display: flex; flex-direction: column; gap: 1.5rem;
		opacity: 0; pointer-events: none; transform: translateX(14px);
		transition: opacity 288ms ease, transform 496ms cubic-bezier(0.32, 0.72, 0, 1);
	}
	:where(.deck:not(:has(.panel:focus-within))) .panel:hover .panel-body, .panel:focus-within .panel-body { opacity: 1; pointer-events: auto; transform: none; transition-delay: 128ms; }
	.panel-stack { display: flex; flex-direction: column; gap: 1rem; min-height: 0; overflow-y: auto; padding: 6px; margin: -6px; scroll-padding-block: 6px; }
	.panel-stack > * { flex-shrink: 0; }
	.panel-empty { margin: 0; color: var(--graphite); }
	.panel-spec { margin: 0; display: flex; justify-content: flex-end; gap: 0.35rem; flex-direction: column; align-items: flex-start; writing-mode: horizontal-tb; white-space: nowrap; flex: none; min-height: 0; overflow: hidden; }
	.panel-spec > div { display: flex; gap: 0.35rem; }
	.panel-spec dt { color: var(--graphite); }
	.panel-spec dd { margin: 0; color: var(--ink); white-space: normal; max-width: 10ch; }
	.panel-blurb { color: var(--graphite); margin: 0; max-width: 34ch; }
	.panel-items { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
	.panel-items li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.8rem; line-height: 1.35; }
	.panel-items .hand { font-size: 0.7rem; }
	.panel-items a { overflow-wrap: anywhere; min-width: 0; }
	.panel-all { flex-shrink: 0; margin-top: auto; align-self: flex-start; font-size: 0.95rem; }

	@media (hover: none), (max-width: 900px) {
		.deck { flex-direction: column; flex: none; height: auto; min-height: 0; container-type: normal; }
		.panel { width: 100%; flex: none; height: auto; transform: none; grid-template-columns: 1fr; background: var(--paper); }
		.panel:hover, .panel:focus-within { flex: none; transform: none; }
		.panel-side { display: grid; grid-template-columns: minmax(0, 1fr) auto; padding: 1.2rem 1.2rem 0; }
		.panel-draw { grid-column: 2; grid-row: 1; width: 3rem; height: 3rem; }
		.panel-title { grid-column: 1; grid-row: 1; margin: 0; writing-mode: horizontal-tb; transform: none; font-size: clamp(1.55rem, 8vw, 2rem); min-width: 0; }
		.panel-title a { padding-block: 0.5rem; margin-block: -0.5rem; }
		.panel-spec { grid-column: 1 / -1; grid-row: 2; flex-direction: row; gap: 1.15rem; flex: none; overflow: visible; writing-mode: horizontal-tb; transform: none; justify-content: flex-start; flex-wrap: wrap; }
		.panel-spec > div { gap: 0.25rem; }
		.panel-spec dd { max-width: none; }
		.panel-body { opacity: 1; pointer-events: auto; transform: none; padding: 1rem 1.2rem 1.4rem; min-width: 0; }
		.panel-stack { overflow: visible; }
	}
	@media (max-width: 640px) {
		.deck { gap: 1.75rem; }
		.panel-side { padding: 1rem 1rem 0; }
		.panel-draw { width: 2.5rem; height: 2.5rem; }
		.panel-body { padding: 0.75rem 1rem 1rem; }
		.panel-stack { gap: 0.75rem; }
	}
</style>
