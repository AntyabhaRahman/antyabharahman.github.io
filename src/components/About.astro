---
interface Props { city?: string; email?: string; cv?: string; }
const { city = '[CITY]', email, cv } = Astro.props;
---
<section class="about rough" data-px-border aria-labelledby="about-name">
	<svg class="about-draw" viewBox="0 0 48 48" aria-hidden="true">
		<path class="hatch" d="M9 41 l5 -5 M9 37 l4 -4 M38 41 l4 -4 M35 41 l7 -7" />
		<path d="M6 5 h36 v38 h-36 z M24 11.5 c4.1 0 7.5 3.4 7.5 7.5 c0 4.1 -3.4 7.5 -7.5 7.5 c-4.1 0 -7.5 -3.4 -7.5 -7.5 c0 -4.1 3.4 -7.5 7.5 -7.5 z M21 17.6 h1.7 M25.3 17.6 h1.7 M21.4 22.4 c1.6 1.6 3.6 1.6 5.2 0 M11 43 c1.6 -8 6.6 -12 13 -12 c6.4 0 11.4 4 13 12" />
	</svg>
	<div class="about-text" data-px>
		<div class="about-name">
			<h1 id="about-name" class="display">Antyabha Rahman</h1>
			<div class="about-role hand"><span>Engineer and researcher</span><span class="about-rule" aria-hidden="true"></span><span>{city}</span></div>
		</div>
		<p class="about-copy">working on ai safety</p>
		<div class="about-links">
			<a class="u" href="https://github.com/AntyabhaRahman">github</a>
			{email ? <span class="about-email">{email.replaceAll('@', ' [at] ')}</span> : <span>[EMAIL]</span>}
			{cv ? <a class="u" href={cv}>resume</a> : <span>Resume available on request via email</span>}
		</div>
	</div>
</section>
<style>
	.about { width: min(70%, 50.4rem); align-self: flex-start; display: grid; grid-template-columns: 4rem minmax(0, 1fr); align-items: center; gap: 1.2rem; padding: 1rem 1.3rem; background: color-mix(in srgb, var(--paper) 78%, transparent); box-shadow: var(--shadow); transform: rotate(-0.55deg); flex: none; }
	.about-draw { width: 4rem; height: 4rem; fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
	.hatch { stroke: var(--graphite); stroke-width: 0.7; opacity: 0.7; }
	.about-text { min-width: 0; display: flex; flex-direction: column; gap: 0.6rem; }
	.about-name { min-width: 0; display: flex; flex-direction: column; gap: 0.4rem; }
	.about h1 { margin: 0; font-size: 1.9rem; }
	.about-role { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 0.8rem; }
	.about-rule { width: 0.9rem; height: 1px; background: var(--pencil); flex: none; }
	.about-copy { margin: 0; font-size: 1.0625rem; line-height: 1.6; }
	.about-links { display: flex; flex-wrap: wrap; align-items: center; gap: 1.4rem; font: 400 0.78rem/1.6 var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; }
	.about-links > span { color: var(--graphite); }
	.about-links > a { text-transform: none; }
	.about-links > .about-email { color: var(--ink); text-transform: none; overflow-wrap: anywhere; min-width: 0; }
	@media (hover: none), (max-width: 900px) {
		.about { width: 100%; transform: none; background: var(--paper); padding: 1.2rem 1.2rem 1.4rem; grid-template-columns: 4rem minmax(0, 1fr); gap: 0.8rem 1rem; }
		.about-text { display: contents; }
		.about-draw { width: 4rem; height: 4rem; }
		.about h1 { font-size: 1.625rem; }
		.about-name { gap: 0.75rem; }
		.about-role { gap: 0.25rem 0.6rem; }
		.about-copy, .about-links { grid-column: 1 / -1; }
		.about-links { row-gap: 0.6rem; margin-top: 0.6rem; }
		.about-links a { display: inline-flex; align-items: center; min-height: 44px; padding-block: 0.6rem; margin-block: -0.6rem; }
	}
</style>
