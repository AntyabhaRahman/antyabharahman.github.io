---
// KaTeX first, so the global sheet that follows it wins on .katex-display.
import 'katex/dist/katex.min.css';
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
export async function getStaticPaths() {
	return (await getCollection('research')).map((p) => ({ params: { slug: p.id }, props: { paper: p } }));
}
const { paper } = Astro.props;
const { Content } = await render(paper);
const d = paper.data;
---
<Article title={d.title} description={d.description} kicker={`${d.venue}, ${d.date.getFullYear()}`} backHref="/research/" backLabel="all papers">
	<div slot="meta">
		<p class="muted" style="margin:0.4rem 0 0">{d.authors.join(', ')}</p>
		<div class="links">
			{d.pdf && <a class="u" href={d.pdf}>PDF</a>}
			{d.arxiv && <a class="u" href={d.arxiv}>arXiv</a>}
			{d.code && <a class="u" href={d.code}>Code</a>}
		</div>
	</div>
	<Content />
</Article>
