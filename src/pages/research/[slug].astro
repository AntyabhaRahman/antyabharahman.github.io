---
import katexStyles from 'katex/dist/katex.min.css?url';
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { venueWithYear } from '../../utils';
export async function getStaticPaths() {
	return (await getCollection('research')).map((p) => ({ params: { slug: p.id }, props: { paper: p } }));
}
const { paper } = Astro.props;
const { Content } = await render(paper);
const hasMath = paper.rendered?.html.includes('class="katex') ?? false;
const d = paper.data;
---
<Article title={d.title} description={d.description} kicker={venueWithYear(d.venue, d.date)} backHref="/research/" backLabel="all papers">
	<Fragment slot="head">{hasMath && <link rel="stylesheet" href={katexStyles} />}</Fragment>
	<div slot="meta">
		<p class="muted" style="margin:0.4rem 0 0">{d.authors.join(', ')}</p>
		<div class="links">
			{d.openreview && <a class="u" href={d.openreview}>OpenReview</a>}
			{d.pdf && <a class="u" href={d.pdf}>PDF</a>}
			{d.arxiv && <a class="u" href={d.arxiv}>arXiv</a>}
			{d.code && <a class="u" href={d.code}>Code</a>}
		</div>
	</div>
	<Content />
</Article>
