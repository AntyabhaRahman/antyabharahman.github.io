---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const papers = (await getCollection('research')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Research · Antyabha Rahman" description="Papers and preprints by Antyabha Rahman.">
	<main class="wrap">
		<h1 class="page-title display" data-px>Research</h1>
		<p class="page-lede" data-px>Papers and preprints. Each page has the short version, the equation that matters, and the links.</p>
		<ol class="list">
			{papers.map((p) => (
				<li class="card rough" data-px data-px-border>
					<h2><a class="u" href={`/research/${p.id}/`}>{p.data.title}</a></h2>
					<p class="muted" style="margin:0">{p.data.authors.join(', ')}</p>
					<p style="margin:0">{p.data.description}</p>
					<div class="meta">
						<span class="hand">{p.data.venue}, {p.data.date.getFullYear()}</span>
						{p.data.pdf && <a class="u" href={p.data.pdf}>PDF</a>}
						{p.data.arxiv && <a class="u" href={p.data.arxiv}>arXiv</a>}
						{p.data.code && <a class="u" href={p.data.code}>Code</a>}
					</div>
				</li>
			))}
		</ol>
	</main>
</Base>
