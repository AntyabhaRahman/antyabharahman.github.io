---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Deck from '../components/Deck.astro';
import About from '../components/About.astro';
import PixelCanvas from '../components/PixelCanvas.astro';
import { byDate } from '../utils';

const section = async (name: 'projects' | 'blog' | 'research') => {
	const all = (await getCollection(name)).sort(byDate);
	return {
		href: `/${name}/`,
		count: all.length,
		items: all.slice(0, 3).map((e) => ({ href: `/${name}/${e.id}/`, title: e.data.title, date: e.data.date })),
	};
};

const panels = [
	{ title: 'Projects', blurb: 'some code im working on', ...(await section('projects')) },
	{ title: 'Blog', blurb: 'thoughts and ideas', ...(await section('blog')) },
	{ title: 'Research', blurb: 'cool research stuff', ...(await section('research')) },
];
---
<Base title="Antyabha Rahman">
	<main id="main" class="hero" tabindex="-1">
		<PixelCanvas mode="ambient" class="hero-canvas" />
		<div class="wrap hero-inner">
			<About city="Sydney" email="antyabha.rahman@student.unsw.edu.au" cv="/resume.pdf" />
			<Deck panels={panels} />
		</div>
	</main>
</Base>

<style>
	/* The hero takes every pixel between the header and the footer, so the field runs down to the footer. */
	.hero { position: relative; padding: 1.5rem 0 1.5rem; overflow: hidden; flex: 1 1 auto; display: flex; flex-direction: column; }
	@media (max-width: 900px) { .hero { padding-top: 1rem; } }
	.hero-inner { position: relative; z-index: 1; flex: 1 1 auto; display: flex; flex-direction: column; gap: 1.25rem; }
	@media (hover: none), (max-width: 900px) { .hero-inner { gap: 1.25rem; } }
	@media (max-width: 640px) { .hero-inner { width: calc(100% - 4rem); gap: 1.75rem; } }
</style>
