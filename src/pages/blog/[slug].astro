---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import Note from '../../components/Note.astro';
export async function getStaticPaths() {
	return (await getCollection('blog')).map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const notes: Record<string, string> = {
	'attention-as-kernel-smoothing': 'At head width 64, the equivalent bandwidth is about 2.83.',
	'why-adam-needs-bias-correction': 'At beta two 0.999, the raw second moment is still 37 percent low at step 1000.',
};
---
<Article title={post.data.title} description={post.data.description} kicker={fmt} backHref="/blog/" backLabel="all posts">
	<div class="meta" slot="meta">
		{post.data.tags.map((t) => <span class="tag">{t}</span>)}
	</div>
	{notes[post.id] && <Note slot="notes" dir="right">{notes[post.id]}</Note>}
	<Content />
</Article>
