---
import katexStyles from 'katex/dist/katex.min.css?url';
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import Note from '../../components/Note.astro';
// The faces a page of maths needs first. Preloaded, so a display equation lays out once.
import katexMain from 'katex/dist/fonts/KaTeX_Main-Regular.woff2?url';
import katexAms from 'katex/dist/fonts/KaTeX_AMS-Regular.woff2?url';
import katexMath from 'katex/dist/fonts/KaTeX_Math-Italic.woff2?url';
import katexSize1 from 'katex/dist/fonts/KaTeX_Size1-Regular.woff2?url';
import katexSize2 from 'katex/dist/fonts/KaTeX_Size2-Regular.woff2?url';
export async function getStaticPaths() {
	return (await getCollection('blog')).map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const hasMath = post.rendered?.html.includes('class="katex') ?? false;
const mathFonts = hasMath ? [katexMain, katexAms, katexMath, katexSize1, katexSize2] : [];
const fmt = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Article title={post.data.title} description={post.data.description} kicker={fmt} backHref="/blog/" backLabel="all posts">
	<Fragment slot="head">{hasMath && <link rel="stylesheet" href={katexStyles} />}{mathFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}</Fragment>
	<div class="meta" slot="meta">
		{post.data.tags.map((t) => <span class="tag"><span class="tag-hash">#</span>{t}</span>)}
	</div>
	{post.data.note && <Note slot="notes" dir="right">{post.data.note}</Note>}
	<Content />
</Article>
