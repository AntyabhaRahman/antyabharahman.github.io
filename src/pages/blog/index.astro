---
import { getCollection } from 'astro:content';
import { byDate } from '../../utils';
import Base from '../../layouts/Base.astro';
const posts = (await getCollection('blog')).sort(byDate);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Blog · Antyabha Rahman" description="thoughts and ideas">
	<main id="main" class="wrap" tabindex="-1">
		<h1 class="page-title display" data-px>Blog</h1>
		<p class="page-lede" data-px>thoughts and ideas</p>
		{posts.length === 0 && <p class="muted" data-px>No posts yet.</p>}
		<ol class="list">
			{posts.map((p) => (
				<li class="card rough" data-px data-px-border>
					<h2><a class="u" href={`/blog/${p.id}/`}>{p.data.title}</a></h2>
					<p class="muted" style="margin:0">{p.data.description}</p>
					<div class="meta">
						<span class="hand">{fmt(p.data.date)}</span>
						{p.data.tags.map((t) => <span class="tag"><span class="tag-hash">#</span>{t}</span>)}
					</div>
				</li>
			))}
		</ol>
	</main>
</Base>
