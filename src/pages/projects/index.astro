---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Projects · Antyabha Rahman" description="Projects built by Antyabha Rahman.">
	<main class="wrap">
		<h1 class="page-title display" data-px>Projects</h1>
		<p class="page-lede" data-px>Things I built and why. Active projects are marked.</p>
		<ol class="list list--grid">
			{projects.map((p) => (
				<li class="card rough" data-px data-px-border>
					<h2><a class="u" href={`/projects/${p.id}/`}>{p.data.title}</a></h2>
					<p class="muted" style="margin:0">{p.data.description}</p>
					<div class="meta">
						<span class="hand">{p.data.status === 'active' ? 'in progress' : p.data.date.getFullYear()}</span>
						{p.data.tags.map((t) => <span class="tag"><span class="tag-hash">#</span>{t}</span>)}
						{p.data.repo && <a class="u" href={p.data.repo}>Repo</a>}
						{p.data.url && <a class="u" href={p.data.url}>Live</a>}
					</div>
				</li>
			))}
		</ol>
	</main>
</Base>
<style>
	.list--grid { grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); align-items: stretch; }
	.list--grid .card { grid-template-rows: auto 1fr auto; }
</style>
